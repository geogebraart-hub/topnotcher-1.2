rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /accounts/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // TOPNOTCHER keeps at most two registered browser/device slots per account.
      // The application registers a device by adding/updating one key in `devices`.
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.devices is map
        && request.resource.data.devices.keys().size() <= 2;
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /appState/{stateKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
